{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/subscriptions.ts",
    "src/skills.ts",
    "src/auth/**/*.ts",
    "src/providers/**/*.ts",
    "src/translate/**/*.ts",
    "src/tools/**/*.ts",
    "src/mcp.ts",
    "src/mcp-schema.ts",
    "src/mcp-config-store.ts",
    "src/mcp-credentials.ts",
    "src/mcp-trust.ts",
    "src/mcp-connection-test.ts",
    "src/mcp-tool-cache.ts",
    "src/mcp-import.ts"
  ]
}
